<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">


    <!-- Заголовок -->
    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_welcome"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:textColor="@color/brand_blue"/>

    <!-- Поле для ввода имени -->
    <EditText
        android:layout_marginTop="20dp"
        android:id="@+id/editTextName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_enter_name"
        android:inputType="textPersonName"
        android:layout_marginBottom="16dp" />

    <!-- Поле для ввода возраста -->
    <EditText
        android:layout_marginTop="20dp"
        android:id="@+id/editTextNumber"
        android:inputType="number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_enter_age"
        android:layout_marginBottom="16dp" />


    <!-- Кнопка действия -->
    <Button
        android:layout_marginTop="20dp"
        android:id="@+id/buttonGreet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_greet"
        android:layout_marginBottom="14dp" />

    <!-- Кнопка очистки -->
    <Button
        android:layout_marginTop="1dp"
        android:id="@+id/buttonClear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_clear"
        android:layout_marginBottom="24dp" />
    <TextView
        android:id="@+id/textColvoNazad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/placeholder_click_counter"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Поле для вывода результата -->
    <TextView
        android:layout_marginTop="20dp"
        android:id="@+id/textViewResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/placeholder_result"
        android:textSize="18sp"
        android:textColor="#333333" />

    <!-- кнопка Сменить заголовок -->
    <Button
        android:id="@+id/buttonChangeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_change_title"
        android:layout_marginTop="12dp" />

    <!-- кнопка Скрыть результат -->
    <Button
        android:id="@+id/buttonHideResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_hide_result"
        android:layout_marginTop="12dp" />
    <!-- Картинка -->
    <ImageView
        android:id="@+id/imageViewIcon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/ic_profile"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/app_name" />
    <!-- Переход на другой экран -->
    <Button
        android:id="@+id/buttonGoToSecond"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_go_to_second"
        android:layout_marginTop="24dp" />

</LinearLayout>